<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="TextPrimary" Color="#EDEDF2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9A9AA5"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#66666F"/>
    <SolidColorBrush x:Key="Accent" Color="#5B9DFF"/>
    <SolidColorBrush x:Key="AccentTint" Color="#295B9DFF"/>
    <SolidColorBrush x:Key="AccentSubtle" Color="#145B9DFF"/>

    <SolidColorBrush x:Key="HoverLayer" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="PressedLayer" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="StrokeLayer" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="ViewportStroke" Color="#22FFFFFF"/>

    <SolidColorBrush x:Key="ViewportBackground" Color="#000000"/>
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C"/>
    <SolidColorBrush x:Key="FallbackBackground" Color="#111114"/>
    <SolidColorBrush x:Key="ToastBackground" Color="#E6202025"/>

    <SolidColorBrush x:Key="ToolipBackground" Color="#F01A1A1E"/>
</ResourceDictionary>
